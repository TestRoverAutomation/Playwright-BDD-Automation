{
  "name": "playwright-bdd-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "test": "npm run bddgen && npm run playwright-test",
    "bddgen": "npx bddgen",
    "clean": "npx rimraf .features-gen",
    "playwright-test": "npx playwright test --reporter=html,list --workers 1 --headed",
    "qa-env": "npm run qa-test",
    "dev-env": "npm run dev-test",
    "prod-env": "npm run prod-test",
    "qa-test": "npx bddgen && cross-env ENV=qa npx playwright test",
    "dev-test": "npx bddgen && cross-env ENV=dev npx playwright test --headed",
    "prod-test": "npx bddgen && cross-env ENV=prod npx playwright test --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "latest",
    "cross-env": "latest",
    "dotenv": "latest",
    "playwright-bdd": "latest",
    "ts-node": "latest",
    "typescript": "latest"
  }
}
